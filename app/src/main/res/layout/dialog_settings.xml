<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_theme"
            android:textColor="@color/kali_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeKali"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/theme_kali"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themePaper"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/theme_paper"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/font_size"
                android:textColor="@color/kali_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fontValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="14"
                android:textColor="@color/kali_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/fontSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="18"
            android:progress="4"
            android:progressTint="@color/kali_accent"
            android:thumbTint="@color/kali_accent" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchWrap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/word_wrap"
            android:textColor="@color/kali_text"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchLineNumbers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/line_numbers"
            android:textColor="@color/kali_text"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/auto_save"
            android:textColor="@color/kali_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_size"
                android:textColor="@color/kali_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="4 spaces"
                android:textColor="@color/kali_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/tabSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="6"
            android:progress="2"
            android:progressTint="@color/kali_accent"
            android:thumbTint="@color/kali_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="Changes apply to the current file immediately. Auto-save writes on pause, tab switch, and Save."
            android:textColor="@color/kali_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
