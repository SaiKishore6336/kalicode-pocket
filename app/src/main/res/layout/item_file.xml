<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/fileIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/files"
        android:src="@drawable/ic_file"
        app:tint="@color/kali_muted" />

    <TextView
        android:id="@+id/fileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/kali_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/fileMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/kali_dim"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/fileChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/open_project"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/kali_dim" />
</LinearLayout>
